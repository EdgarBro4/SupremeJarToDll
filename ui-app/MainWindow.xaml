<Window x:Class="JarToDllBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supreme Jar To Dll"
        Width="860"
        Height="760"
        MinWidth="760"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Border Background="{StaticResource BgDeep}"
            BorderBrush="#36141A"
            BorderThickness="1.5"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3" />
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Crimson Accent Bar -->
            <Border Grid.Row="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#99070F" Offset="0" />
                        <GradientStop Color="#FF1E2D" Offset="0.5" />
                        <GradientStop Color="#99070F" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Custom Draggable Header Bar -->
            <Border Grid.Row="1"
                    Background="#0C0C12"
                    BorderBrush="#1E1E2A"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="18,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource AccentRed}" Margin="0,0,12,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#E50914" BlurRadius="10" ShadowDepth="0" Opacity="0.55" />
                            </Border.Effect>
                            <TextBlock Text="S" Foreground="White" FontWeight="Black" FontSize="15.5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="SUPREME JAR TO DLL" Foreground="{StaticResource TextPrimary}"
                                           FontWeight="Black" FontSize="14.5" />
                                <Border Background="#26E50914" BorderBrush="#66E50914" BorderThickness="1"
                                        CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="FORGE BUILDER" Foreground="#FF4550"
                                               FontWeight="Bold" FontSize="9.5" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Minecraft 1.16.5 &amp; 1.21.4 Native DLL Packer"
                                       Foreground="{StaticResource TextMuted}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="—" Style="{StaticResource CaptionButton}" Click="BtnMinimize_Click" Margin="0,0,4,0" />
                        <Button Content="✕" Style="{StaticResource CaptionCloseButton}" Click="BtnClose_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="2" Margin="20,16,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- SECTION 1: Minecraft Version Selector -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="TARGET MINECRAFT FORGE VERSION"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="10.5" FontWeight="Bold" Margin="2,0,0,7" />

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <RadioButton x:Name="RbVersion1165"
                                     Grid.Column="0"
                                     GroupName="McVersion"
                                     Style="{StaticResource VersionCardRadio}"
                                     Checked="VersionRadio_Checked">
                            <StackPanel>
                                <TextBlock Text="Minecraft 1.16.5 (Forge)"
                                           FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="Java 8 • TransformingClassLoader • EventBus 4.x • 1.16.5 Libs"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="RbVersion1214"
                                     Grid.Column="2"
                                     GroupName="McVersion"
                                     IsChecked="True"
                                     Style="{StaticResource VersionCardRadio}"
                                     Checked="VersionRadio_Checked">
                            <StackPanel>
                                <TextBlock Text="Minecraft 1.21.4 (Forge)"
                                           FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="Java 21 • ModuleClassLoader • JPMS Unlock • LayeredDraw"
                                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </Grid>

                <!-- SECTION 2: Input .jar Upload -->
                <Border Grid.Row="1"
                        Background="{StaticResource BgCard}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="15,12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="INPUT MOD FILE (.JAR)"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="10.5" FontWeight="Bold" />
                                <TextBlock x:Name="TxtSelectedJar"
                                           Text="No .jar uploaded — click Upload or drag &amp; drop a .jar file anywhere"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,4,0,0" />
                                <TextBlock x:Name="TxtJarMeta"
                                           Text="Supports Forge mod JARs for 1.16.5 and 1.21.4"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button x:Name="BtnUpload"
                                    Grid.Column="1"
                                    Content="Upload"
                                    Style="{StaticResource UploadAccentButton}"
                                    VerticalAlignment="Center"
                                    Click="BtnUpload_Click" />
                        </Grid>

                        <!-- Optional Extra Library JARs Row -->
                        <Border Background="#0D0D13" BorderBrush="#1F1F2B" BorderThickness="1"
                                CornerRadius="7" Padding="10,6" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtExtraLibs"
                                           Text="Extra dependency library JARs: None (1.16.5/1.21.4 shaded libs auto-handled)"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="11" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Button x:Name="BtnAddLibs"
                                        Grid.Column="1"
                                        Content="+ Add Lib JAR"
                                        Style="{StaticResource SecondaryDarkButton}"
                                        Padding="10,4" FontSize="11" Margin="8,0,0,0"
                                        Click="BtnAddLibs_Click" />
                                <Button x:Name="BtnClearLibs"
                                        Grid.Column="2"
                                        Content="Clear"
                                        Style="{StaticResource SecondaryDarkButton}"
                                        Padding="8,4" FontSize="11" Margin="6,0,0,0"
                                        Visibility="Collapsed"
                                        Click="BtnClearLibs_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- SECTION 3: Output Destination & Name -->
                <Border Grid.Row="2"
                        Background="{StaticResource BgCard}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="15,12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.45*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <!-- Destination Folder -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="OUTPUT DESTINATION"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="10.5" FontWeight="Bold" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtOutputDir"
                                             Style="{StaticResource DarkTextBox}"
                                             TextChanged="OutputFields_TextChanged" />
                                    <Button x:Name="BtnBrowseOut"
                                            Grid.Column="2"
                                            Content="Browse"
                                            Style="{StaticResource SecondaryDarkButton}"
                                            Click="BtnBrowseOut_Click" />
                                </Grid>
                            </StackPanel>

                            <!-- Output Name -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="OUTPUT DLL NAME"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="10.5" FontWeight="Bold" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtOutputName"
                                             Text="output"
                                             Style="{StaticResource DarkTextBox}"
                                             TextChanged="OutputFields_TextChanged" />
                                    <Border Grid.Column="1" Background="#1D1216" BorderBrush="#3B1A20" BorderThickness="1"
                                            CornerRadius="6" Padding="9,0" Margin="6,0,0,0">
                                        <TextBlock Text=".dll" Foreground="#FF4550" FontWeight="Bold"
                                                   FontSize="12.5" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="TxtOutputPreview"
                                   Text="Final output: output.dll"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="11" Margin="2,7,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- SECTION 4: Build Dependencies & Toolchain -->
                <Border Grid.Row="3"
                        Background="{StaticResource BgCard}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="15,11"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="BUILD DEPENDENCIES (AUTO-DOWNLOAD IF MISSING)"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <Ellipse x:Name="DotJdk" Width="8" Height="8" Fill="{StaticResource StatusWarn}" Margin="0,0,7,0" />
                                <TextBlock x:Name="TxtJdkStatus" Text="JDK: Checking..."
                                           Foreground="{StaticResource TextPrimary}" FontSize="11.5" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="DotCpp" Width="8" Height="8" Fill="{StaticResource StatusWarn}" Margin="0,0,7,0" />
                                <TextBlock x:Name="TxtCppStatus" Text="Compiler: Checking..."
                                           Foreground="{StaticResource TextPrimary}" FontSize="11.5" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="C++ TOOLCHAIN"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
                            <ComboBox x:Name="CmbToolchain"
                                      Style="{StaticResource DarkComboBox}"
                                      SelectedIndex="0"
                                      SelectionChanged="CmbToolchain_SelectionChanged">
                                <ComboBoxItem Content="Auto (Recommended)" Tag="Auto" />
                                <ComboBoxItem Content="Portable MinGW-w64 (g++)" Tag="PortableMinGW" />
                                <ComboBoxItem Content="MSVC (Visual Studio)" Tag="Msvc" />
                                <ComboBoxItem Content="WSL (g++-mingw-w64)" Tag="WslMinGW" />
                            </ComboBox>
                        </StackPanel>

                        <Button x:Name="BtnInstallDeps"
                                Grid.Column="4"
                                Content="Check / Install Deps"
                                Style="{StaticResource SecondaryDarkButton}"
                                VerticalAlignment="Bottom"
                                Click="BtnInstallDeps_Click" />
                    </Grid>
                </Border>

                <!-- SECTION 5: Build Action Bar & Progress -->
                <Grid Grid.Row="4" Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnBuild"
                                Grid.Column="0"
                                Content="BUILD DLL"
                                Height="44"
                                Style="{StaticResource PrimaryRedButton}"
                                Click="BtnBuild_Click" />

                        <Button x:Name="BtnOpenOutput"
                                Grid.Column="2"
                                Content="Open Output Folder"
                                Height="44"
                                Style="{StaticResource SecondaryDarkButton}"
                                IsEnabled="False"
                                Click="BtnOpenOutput_Click" />
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <Grid Margin="0,0,0,5">
                            <TextBlock x:Name="TxtProgressStage"
                                       Text="Ready to build."
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="11.5" FontWeight="SemiBold" />
                            <TextBlock x:Name="TxtProgressPct"
                                       Text="0%"
                                       Foreground="#FF4550"
                                       FontSize="11.5" FontWeight="Bold"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <ProgressBar x:Name="BuildProgressBar"
                                     Minimum="0" Maximum="100" Value="0"
                                     Style="{StaticResource CrimsonProgressBar}" />
                    </StackPanel>
                </Grid>

                <!-- SECTION 6: Live Build Console -->
                <Border Grid.Row="5"
                        Background="{StaticResource BgConsole}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="2,0,2,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentRed}" Margin="0,0,7,0" />
                                <TextBlock Text="BUILD CONSOLE" Foreground="{StaticResource TextSecondary}"
                                           FontSize="10" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Copy Log" Style="{StaticResource SecondaryDarkButton}"
                                        Padding="8,3" FontSize="10.5" Margin="0,0,6,0" Click="BtnCopyLog_Click" />
                                <Button Content="Clear" Style="{StaticResource SecondaryDarkButton}"
                                        Padding="8,3" FontSize="10.5" Click="BtnClearLog_Click" />
                            </StackPanel>
                        </Grid>

                        <TextBox x:Name="TxtConsole"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 Foreground="#D4D4E0"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, Cascadia Mono, Courier New"
                                 FontSize="11.5" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
